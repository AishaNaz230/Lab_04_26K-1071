// QNO:6  get and process current time from user
#include <stdio.h>

int main()
{
    float current_total_bill;
    int current_time;
    float total_bill;

    printf("Enter current_total_bill\n");
    scanf("%f", &current_total_bill);

    printf("Enter current_time of the day in 24hours\n");
    scanf("%d", &current_time);
    if (current_time >= 0 || current_time <= 23)
    {
        if (current_time >= 11 && current_time <= 14)
        {
            printf("10 percentage discount is available for you\n");
            total_bill = current_total_bill - (current_total_bill * 0.10);
            printf("total bill after discount of 10 percentage is %.3f\n", total_bill);
        }
        else
        {
            printf("discount is not available for you\n");
            total_bill = current_total_bill - 0;
            printf("total bill is %.3f\n", total_bill);
        }
    }
    else
    {
        printf("You have entered wrong hours which is not in between of 0 and 23");
    }
}